{
  "name": "linkedin-job-filter-extension",
  "version": "1.0.0",
  "description": "Advanced Chrome extension for filtering LinkedIn job postings",
  "scripts": {
    "lint": "eslint *.js content/*.js utils/workflow_exporter.js utils/workflow_profile.js utils/scan_planner.js",
    "lint:fix": "eslint *.js content/*.js utils/workflow_exporter.js utils/workflow_profile.js utils/scan_planner.js --fix",
    "validate": "node scripts/validate-manifest.js",
    "test": "jest --selectProjects unit dom",
    "test:watch": "jest --watch --selectProjects unit dom",
    "test:coverage": "jest --coverage --selectProjects unit dom",
    "test:e2e": "jest --selectProjects e2e",
    "test:all": "jest"
  },
  "keywords": [
    "linkedin",
    "jobs",
    "filter",
    "chrome-extension",
    "browser-extension"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "puppeteer": "^24.32.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
